{
  "manifest_version": 3,
  "name": "Remember Sidebar",
  "version": "1.0.0",
  "description": "Remembers when you close the Spaces sidebar on miro.com boards, so it stays closed instead of reopening on every board load.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://miro.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Click to enable sidebar toggle preference",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  }
}
